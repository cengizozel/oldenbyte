# Copy to .env (gitignored) and fill in. See README.md.

# Full Anytype session token. Mint with: .venv/bin/python -m anytype_grpc.auth
ANYTYPE_TOKEN=

# Shared secret between the dashboard and this bridge. Any long random string:
#   openssl rand -hex 24
BRIDGE_TOKEN=

# Bind address. 127.0.0.1 = this machine only (dev). Set to your tailscale IP
# to let the prod dashboard reach it.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=31010

# Optional: pin the gRPC address instead of auto-discovery.
#ANYTYPE_GRPC_ADDR=127.0.0.1:31007
