{
  "id": "tautulli-activity",
  "title": "Plex activity",
  "description": "Current Plex streams, through your Tautulli.",
  "color": "amber",
  "category": "media",
  "defaultSize": {
    "w": 1,
    "h": 2
  },
  "config": [
    {
      "key": "url",
      "label": "Address",
      "type": "url",
      "placeholder": "http://tautulli.lan:8181"
    },
    {
      "key": "apiKey",
      "label": "API key",
      "type": "secret",
      "hint": "Tautulli, Settings, Web Interface."
    }
  ],
  "fetch": {
    "url": "{config.url}/api/v2?apikey={config.apiKey}&cmd=get_activity",
    "cacheMinutes": 1
  },
  "layout": [
    {
      "component": "stat-row",
      "items": [
        {
          "label": "Streams",
          "value": "$.response.data.stream_count | number"
        }
      ]
    },
    {
      "component": "list",
      "path": "$.response.data.sessions",
      "title": "$.full_title",
      "subtitle": "$.player",
      "meta": "$.friendly_name",
      "limit": 10
    }
  ]
}
